# Required: Up API token from the Up developer portal.
UP_API_TOKEN=

# Required: YNAB budget ID (visible in the YNAB web app URL).
YNAB_BUDGET_ID=

# Required: YNAB personal access token.
YNAB_API_TOKEN=

# Required: JSON object mapping each Up account ID to the YNAB account ID it syncs into.
# Example:
# {"222e1edc-...":"e478350d-...","33d9ec07-...":"2112c8b2-..."}
UP_ACCOUNT_MAP={"up-account-id":"ynab-account-id"}

# Only required in -serve mode: secret returned when registering the Up webhook.
UP_WEBHOOK_SECRET=

# Optional: path to the SQLite sync-state database.
DB_PATH=sync.db

# Optional: port to listen on in -serve mode.
PORT=8080

# Optional: how often the reconciliation loop runs in -serve mode.
CRON_INTERVAL=1h

# Optional: comma-separated YNAB account IDs that should fund the savings
# category when linked transfers land in them.
YNAB_SAVINGS_ACCOUNT_IDS=

# Optional: YNAB category ID funded by savings-account transfers.
YNAB_SAVINGS_CATEGORY_ID=
